---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Font from 'astro/components/Font.astro';
import { HeaderControls } from '@/components/features/HeaderControls';
import { CourseOverlays } from '@/components/features/CourseOverlays';
import './CourseLayout.loader.css';
import styles from './CourseLayout.module.css';

interface Props {
  /** Per-lesson name; folded into the document title and omitted on the home page. */
  title?: string;
  /** Per-page meta description; a course-level default is used when absent. */
  description?: string;
  currentLessonId?: string;
}

const { title, description, currentLessonId } = Astro.props;
const documentTitle = title ? `${title} | Vim Course | freeCodeCamp.org` : 'Vim Course | freeCodeCamp.org';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Pre-paint theme stamp. Runs before the stylesheet applies, so a light-theme
      // learner never sees a dark flash. The key is duplicated from THEME_STORAGE_KEY
      // in src/hooks/useTheme.ts because inline scripts cannot import; CourseLayout.test.ts
      // guards the two against drift.
      try {
        const stored = localStorage.getItem('vim-course:theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        } else {
          // No stored preference; check system theme
          document.documentElement.dataset.theme = window.matchMedia(
            '(prefers-color-scheme: light)'
          ).matches
            ? 'light'
            : 'dark';
        }
      } catch {
        // Storage unavailable; check system theme as fallback
        document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: light)')
          .matches
          ? 'light'
          : 'dark';
      }
      try {
        if (localStorage.getItem('vim-course:animationsEnabled') === 'false') {
          document.documentElement.setAttribute('data-reduced-motion', '');
        }
      } catch {
        /* Storage unavailable; skip reduced-motion stamping. */
      }
    </script>
    <style is:inline>
      /*
       * Full-page loader shown on first paint, before the React island mounts.
       * CourseLayout.loader.css hides it via body:has([data-home-page]) and
       * body:has([data-lesson-page]) once the island renders.
       *
       * Colors are hardcoded to match the design tokens in colors.css so the
       * loader looks correct without any external CSS.
       */
      html {
        block-size: 100vh;
        overflow: hidden;
      }

      [data-page-loader] {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: grid;
        place-items: center;
        /* Dark theme default */
        background: #0a0a23;
      }

      :root[data-theme='light'] [data-page-loader] {
        background: #fff;
      }

      [data-page-loader] svg {
        inline-size: 3.5rem;
        block-size: 3.5rem;
        display: block;
      }

      @keyframes page-loader-spin {
        to {
          transform: rotate(360deg);
        }
      }

      [data-page-loader] .loader-base {
        stroke: #3b3b4f;
        stroke-linecap: round;
      }

      :root[data-theme='light'] [data-page-loader] .loader-base {
        stroke: #939393;
      }

      [data-page-loader] .loader-arc {
        stroke: #f5f6f7;
        stroke-linecap: round;
        transform-box: view-box;
        transform-origin: center;
        animation: page-loader-spin 0.9s linear infinite;
      }

      :root[data-theme='light'] [data-page-loader] .loader-arc {
        stroke: #0a0a23;
      }

      @media (prefers-reduced-motion: reduce) {
        [data-page-loader] .loader-arc {
          animation: none;
        }
      }
    </style>
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}
    <Font cssVariable="--font-lato" preload />
    <Font cssVariable="--font-inconsolata" preload />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" />
    <link rel="preload" href="/data/curriculum-tree.json" as="fetch" crossorigin />
    <ClientRouter />
  </head>
  <body>
    <div data-page-loader role="status" aria-label="Loading page">
      <svg viewBox="0 0 56 56" aria-hidden="true" focusable="false">
        <circle class="loader-base" cx="28" cy="28" r="22" fill="none" stroke-width="6" />
        <circle class="loader-arc" cx="28" cy="28" r="22" fill="none" stroke-width="6" stroke-dasharray="103.67 34.56" />
      </svg>
    </div>
    <a href="#main" class="sr-only">Skip to main content</a>
    <header class={styles.header}>
      <a href="/" class={styles['home-link']}>Vim Course</a>
      <HeaderControls
        showDrawer={Boolean(currentLessonId)}
        showShortcuts={Boolean(currentLessonId)}
        client:only="react"
      />
    </header>
    <slot />
    <CourseOverlays currentLessonId={currentLessonId} client:only="react" />
  </body>
</html>
