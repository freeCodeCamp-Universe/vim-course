---
import { getLessonById, loadCurriculum } from '@/curriculum/loader';
import CourseLayout from '@/layouts/CourseLayout.astro';
import { LessonPage } from '@/views/LessonPage';
import loaderStyles from '@/components/base/LoadingState/LoadingState.module.css';

export function getStaticPaths() {
  return loadCurriculum()
    .modules.flatMap((module) => module.lessonIds)
    .map((lessonId) => ({ params: { lessonId } }));
}

const lesson = getLessonById(Astro.params.lessonId!);
if (!lesson) {
  // getStaticPaths only emits ids that resolve, so this is unreachable at build
  // time; it narrows the type and fails loudly if the two ever drift.
  throw new Error(`No lesson found for id "${Astro.params.lessonId}"`);
}
---

<CourseLayout title={lesson.title} currentLessonId={lesson.id}>
  <div class={loaderStyles.container} role="status" aria-label="Loading lesson" data-loading-state>
    <svg class={loaderStyles.spinner} viewBox="0 0 56 56" aria-hidden="true" focusable="false">
      <circle class={loaderStyles['base-ring']} cx="28" cy="28" r="22" fill="none" stroke-width="6" />
      <circle class={loaderStyles.arc} cx="28" cy="28" r="22" fill="none" stroke-width="6" stroke-linecap="round" stroke-dasharray="103.67 34.56" />
    </svg>
    <span class="sr-only">Loading…</span>
  </div>
  <LessonPage lesson={lesson} client:only="react" />
</CourseLayout>
