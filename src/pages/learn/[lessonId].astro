---
import { getLessonById, loadCurriculum } from '@/curriculum/loader';
import { isProseLesson, toClientLesson } from '@/curriculum/types';
import { renderMarkdown } from '@/components/base/Markdown/renderMarkdown';
import { extractHeadings } from '@/utils/extractHeadings';
import CourseLayout from '@/layouts/CourseLayout.astro';
import { LessonPage } from '@/views/LessonPage';
import loaderStyles from '@/components/base/LoadingState/LoadingState.module.css';

export function getStaticPaths() {
  return loadCurriculum()
    .modules.flatMap((module) => module.lessonIds)
    .map((lessonId) => ({ params: { lessonId } }));
}

const lesson = getLessonById(Astro.params.lessonId!);
if (!lesson) {
  // getStaticPaths only emits ids that resolve, so this is unreachable at build
  // time; it narrows the type and fails loudly if the two ever drift.
  throw new Error(`No lesson found for id "${Astro.params.lessonId}"`);
}

const orderedLessonIds = loadCurriculum().modules.flatMap((module) => module.lessonIds);
const currentIndex = orderedLessonIds.indexOf(lesson.id);
const nextLessonId = orderedLessonIds[currentIndex + 1];
const isLastLesson = currentIndex === orderedLessonIds.length - 1;

const instructionsHtml = renderMarkdown(lesson.instructions);

const segmentHtmls = isProseLesson(lesson) && lesson.instructionSegments
  ? lesson.instructionSegments.map((seg) =>
      seg.kind === 'markdown' ? renderMarkdown(seg.content) : ''
    )
  : undefined;

// Pre-compute headings for the table-of-contents so raw markdown is not
// shipped to the client. Only prose lessons render an outline.
const headings = isProseLesson(lesson)
  ? extractHeadings(
      lesson.instructionSegments
        ? lesson.instructionSegments
            .filter((s): s is { kind: 'markdown'; content: string } => s.kind === 'markdown')
            .map((s) => s.content)
            .join('\n')
        : lesson.instructions
    )
  : [];

const clientLesson = toClientLesson(lesson);
---

<CourseLayout title={lesson.title} currentLessonId={lesson.id}>
  <div class={loaderStyles.container} role="status" aria-label="Loading lesson" data-loading-state>
    <svg class={loaderStyles.spinner} viewBox="0 0 56 56" aria-hidden="true" focusable="false">
      <circle class={loaderStyles['base-ring']} cx="28" cy="28" r="22" fill="none" stroke-width="6" />
      <circle class={loaderStyles.arc} cx="28" cy="28" r="22" fill="none" stroke-width="6" stroke-linecap="round" stroke-dasharray="103.67 34.56" />
    </svg>
    <span class="sr-only">Loading…</span>
  </div>
  <LessonPage lesson={clientLesson} nextLessonId={nextLessonId} isLastLesson={isLastLesson} instructionsHtml={instructionsHtml} segmentHtmls={segmentHtmls} headings={headings} client:only="react" />
</CourseLayout>
