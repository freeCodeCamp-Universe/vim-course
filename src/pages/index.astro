---
import { loadCurriculum } from '@/curriculum/loader';
import type { CurriculumTreeModule } from '@/components/features/CurriculumTree';
import CourseLayout from '@/layouts/CourseLayout.astro';
import { Home } from '@/views/Home';
import { FccLogoIcon } from '@/components/base/Icon';
import styles from './HomePage.module.css';

const { modules, lessons } = loadCurriculum();
const titleById = new Map(lessons.map((lesson) => [lesson.id, lesson.title]));
const treeModules: CurriculumTreeModule[] = modules.map((module, index) => ({
  number: index + 1,
  slug: module.slug,
  title: module.title,
  lessons: module.lessonIds.map((id) => ({ id, title: titleById.get(id) ?? id })),
}));
const orderedLessonIds = modules.flatMap((module) => module.lessonIds);
---

<CourseLayout>
  <main id="main" class={styles.page} tabindex="-1">
    <h1 class={styles.title}>Learn Vim for Terminal Text Editing</h1>
    <Home modules={treeModules} orderedLessonIds={orderedLessonIds} client:load />
  </main>
  <footer class={styles.footer}>
    <p class={styles['footer-text']}>
      <FccLogoIcon className={styles['footer-logo']} />
      <span>
        Developed by the <a
          href="https://www.freecodecamp.org"
          target="_blank"
          rel="noopener noreferrer"
          class={styles['footer-link']}>freeCodeCamp</a
        > team
      </span>
    </p>
  </footer>
</CourseLayout>

<script define:vars={{ orderedLessonIds }} is:inline>
  (function () {
    try {
      const raw = localStorage.getItem('vim-course:progress');
      if (!raw) return;
      const parsed = JSON.parse(raw);
      if (!parsed || parsed.version !== 1 || !Array.isArray(parsed.completed)) return;

      const validIds = new Set(orderedLessonIds);
      const completedIds = parsed.completed.filter(function (id) {
        return typeof id === 'string' && validIds.has(id);
      });
      if (completedIds.length === 0) return;
      const completedSet = new Set(completedIds);

      document.querySelectorAll('[data-lesson-id]').forEach(function (el) {
        if (completedSet.has(el.dataset.lessonId)) {
          el.dataset.state = 'completed';
        }
      });

      const progress = document.querySelector('[data-progress]');
      if (progress) {
        const total = progress.dataset.progressTotal;
        const vis = progress.querySelector('[data-progress-visible]');
        const sr = progress.querySelector('[data-progress-sr]');
        if (vis) vis.textContent = completedIds.length + '/' + total + ' lessons completed';
        if (sr) sr.textContent = completedIds.length + ' out of ' + total + ' lessons completed';
      }
    } catch {
      // Ignore malformed stored progress
    }
  })();
</script>
