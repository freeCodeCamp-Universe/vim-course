{
  "name": "vim-course",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@10.34.1+sha512.b58fbde6dca66a929538021581f648b4570b6ca19b18e7cbd7f2c07a7b24454155388dacdf08f2af3678e88a6d1fe04f9d609df24bf51735a060ea041b374ab7",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm build-lesson-data && vite",
    "build": "pnpm build:lesson-data && pnpm build:typecheck && pnpm build:vite && pnpm build:static-routes",
    "build:lesson-data": "NODE_ENV=production pnpm build-lesson-data",
    "build:typecheck": "tsc --noEmit --pretty false",
    "build:vite": "vite build",
    "build:static-routes": "node --import tsx/esm --import ./scripts/prebuild-register.ts scripts/generate-spa-routes.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "lint:styles": "stylelint \"**/*.css\"",
    "build-lesson-data": "node --import tsx/esm --import ./scripts/prebuild-register.ts scripts/build-lesson-data.ts",
    "add-module": "tsx scripts/add-module.ts",
    "add-lesson": "tsx scripts/add-lesson.ts",
    "sync-curriculum-doc": "tsx scripts/sync-curriculum-doc.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/eslint-plugin": "1.6.23",
    "bson": "6.10.4",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "eslint-plugin-testing-library": "7.16.2",
    "jsdom": "30.0.1",
    "lint-staged": "15.5.2",
    "marked": "18.0.9",
    "prettier": "3.9.6",
    "sanitize-html": "2.17.7",
    "stylelint": "17.14.1",
    "stylelint-config-css-modules": "4.6.0",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx,css}": "prettier --write"
  }
}
