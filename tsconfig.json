{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // React is staying: islands compile with the automatic runtime, and `.astro`
    // files are handled by the Astro compiler, not this jsx setting.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [".astro/types.d.ts", "src", "vitest.config.ts"],
  "exclude": ["dist"]
}
